# Required: https://console.typesafe.ai
TYPESAFE_API_KEY=

# Feedback after an action: ding (chime) | voice (spoken butler)
FEEDBACK=ding
# PERSONA=alfred (posh UK butler) | cowboy | plain ; USER_NAME is used in "master <name>"
PERSONA=alfred
USER_NAME=Wayne

# Optional better voice (ElevenLabs Flash, cached to disk). Defaults: alfred=George, cowboy=Bill
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Hands-free: names that address the assistant; follow-up window after a command (seconds)
WAKE_WORDS=alfred,jarvis,alfie,alford,elfred
FOLLOWUP_SECONDS=8
# Unnamed utterances: 1 = let Jev judge if it's a command; gates 0..1 (0 = never ignore)
UNNAMED_COMMANDS=1
UNNAMED_MIN_ADDRESSED=0
UNNAMED_MIN_CONFIDENCE=0

# OVERLAY=0 to hide the floating transcription pill
OVERLAY=1

# Opt-in Caps Lock push-to-talk. 1 = remap Caps Lock -> F18 (Caps Lock stops toggling
# capitals) and tap it to talk. 0 = wake word only, Caps Lock left untouched.
CAPSLOCK_PTT=0

# VAD (voice activity detection) tuning. Raise PRE_ROLL / lower THRESHOLD_MULT if the
# first word gets clipped; raise END_SILENCE if long sentences get cut short.
VAD_PRE_ROLL_MS=500
VAD_END_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250
VAD_MAX_SPEECH_MS=12000
VAD_START_FRAMES=2
VAD_THRESHOLD_MULT=3.0

# Whisper model. Default is base.en (fast). Download ggml-small.en.bin and point here for
# noticeably better accuracy, e.g. WHISPER_MODEL=models/ggml-small.en.bin
# WHISPER_MODEL=models/ggml-base.en.bin

# Source language and optional translation to English. Translation needs a multilingual
# model (e.g. ggml-large-v3-turbo.bin), not the .en ones. "auto" detects the language.
# WHISPER_LANG=auto
# WHISPER_TRANSLATE=1
